# Safe-to-expose browser configuration. Never put credentials in NEXT_PUBLIC_* values.
NEXT_PUBLIC_APP_NAME=StaffFlow Admin
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Server-only AWS/Cognito configuration.
MY_AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_MOBILE_CLIENT_ID=
COGNITO_ISSUER_URL=

# Server-only API and data services.
API_GATEWAY_URL=
API_GATEWAY_WS_URL=
DYNAMODB_TABLE_NAME=StaffFlow
S3_BUCKET_NAME=
GEMINI_API_KEY=

# Server-only auth / integrations.
AUTH_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=
